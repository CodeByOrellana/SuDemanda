# ============================================
# SuDemanda - Variables de entorno
# Copia este archivo a `.env` y completa los valores.
# NUNCA subas `.env` a git (ya está en .gitignore).
# ============================================

# API key de Resend: https://resend.com/api-keys
RESEND_API_KEY=

# Remitente del correo. Debe ser un dominio verificado en Resend.
# En el plan gratis puedes usar: SuDemanda <onboarding@resend.dev>
EMAIL_FROM=SuDemanda <onboarding@resend.dev>

# Bandeja de entrada donde quieres recibir los mensajes del sitio.
EMAIL_TO=leojuridico@gmail.com
